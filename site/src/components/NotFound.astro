---
/**
 * What a reader sees at an address with no page. The page script
 * (client/not-found.ts) first tries to turn the address into the page it
 * means; until it has decided, the content stays hidden (with scripts) so a
 * redirect does not flash it. Close matches are filled in from the directory
 * index, with the words of the address in the search box.
 */
import {LIMITS, type Locale} from '../config.ts';
import {messages} from '../i18n/index.ts';
import {paths} from '../model/urls.ts';
import {catalog} from '../server/site.ts';
import {SearchIcon} from './Icons.tsx';

interface Props {
  locale: Locale;
  /** Set on /{locale}/not-found/, which explains an address another page could not serve (?path=). */
  localized?: boolean;
}

const {locale, localized = false} = Astro.props;
const m = messages(locale);
const labels = JSON.stringify({roles: m.roles, kinds: m.kinds, story: m.nav.stories}).replace(/</g, '\\u003c');
---

<div class="shell">
  <div
    class="error-page"
    data-not-found
    data-pending
    data-locale={locale}
    data-edition={catalog.edition.id}
    data-localized={localized ? '' : undefined}
  >
    <h1>{m.errors.notFound}</h1>
    <p class="lede">{m.errors.notFoundBody}</p>
    <section aria-labelledby="matches-title" data-matches hidden>
      <h2 id="matches-title">{m.errors.suggestions}</h2>
      <ul class="link-list" data-match-list></ul>
    </section>
    <form method="get" action={paths.home(locale)} class="search" role="search">
      <label for="nf-q" class="sr-only">{m.directory.searchLabel}</label>
      <div class="search-field"><SearchIcon /><input id="nf-q" type="search" name="q" placeholder={m.directory.searchPlaceholder} maxlength={LIMITS.query} /></div>
      <button class="button" type="submit">{m.directory.searchButton}</button>
    </form>
    <p><a href={paths.home(locale)}>{m.errors.backToDirectory}</a></p>
    <script type="application/json" data-not-found-labels set:html={labels} />
  </div>
</div>
<script>
  import '../client/not-found.ts';
</script>
