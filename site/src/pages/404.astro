---
/**
 * Not found. A static host serves this file, with status 404, for any address
 * it has no file for. Its script turns a mistyped, old or locale-less address
 * into the page it means when there is one, and otherwise suggests close
 * matches (components/NotFound.astro). It is written in English; readers of
 * another language are sent to the not-found page in theirs.
 */
import Base from '../layouts/Base.astro';
import NotFound from '../components/NotFound.astro';
import {DEFAULT_LOCALE, PRODUCT} from '../config.ts';
import {messages} from '../i18n/index.ts';
import {paths} from '../model/urls.ts';
import {EVALUATION_DATE} from '../server/site.ts';

const locale = DEFAULT_LOCALE;
const m = messages(locale);
---

<Base locale={locale} title={`${m.errors.notFound} · ${PRODUCT.name}`} description={m.errors.notFoundBody} path={paths.home(locale)} noindex evaluationDate={EVALUATION_DATE}>
  <NotFound locale={locale} />
</Base>
