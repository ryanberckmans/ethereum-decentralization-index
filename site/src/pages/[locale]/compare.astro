---
/**
 * /{locale}/compare/?ids=a,b,c: up to four exact EDI records side by side.
 * The page is built once with suggested comparisons; the compare island reads
 * the records from the address and draws the comparison in the browser.
 * Comparisons are not indexed; their links stay canonical.
 */
import Base from '../../layouts/Base.astro';
import CompareApp from '../../islands/CompareApp.tsx';
import {CompareHead, CompareStart, compareMessages} from '../../views/Compare.tsx';
import {LOCALES, PRODUCT, type Locale} from '../../config.ts';
import {messages} from '../../i18n/index.ts';
import {paths} from '../../model/urls.ts';
import {catalog, EVALUATION_DATE} from '../../server/site.ts';

export function getStaticPaths() {
  return LOCALES.map(locale => ({params: {locale}}));
}

const locale = Astro.params.locale as Locale;
const m = messages(locale);
const env = {locale, m, date: EVALUATION_DATE};
const title = `${m.compare.title} · ${PRODUCT.name}`;
---

<Base locale={locale} title={title} description={m.compare.intro} path={paths.compare(locale)} current="compare" evaluationDate={EVALUATION_DATE}>
  <div class="shell compare">
    <CompareHead env={env} />
    <CompareApp
      client:load
      locale={locale}
      m={compareMessages(locale)}
      title={title}
      evaluatedFor={EVALUATION_DATE}
      indexUrl={paths.index(locale, catalog.edition.id)}
      dataUrl={paths.compareData(locale, catalog.edition.id)}
    >
      <CompareStart env={env} />
    </CompareApp>
  </div>
</Base>
