---
/** Dated editorial changes, the EDI edition in use, and the grade changes its review dates will make. */
import Base from '../../layouts/Base.astro';
import {ChangesPage} from '../../views/Changes.tsx';
import {isLocale, PRODUCT} from '../../config.ts';
import {messages} from '../../i18n/index.ts';
import {paths} from '../../model/urls.ts';
import {evaluationDateFor} from '../../server/site.ts';

const {locale} = Astro.params;
if (!isLocale(locale)) return Astro.rewrite('/404');
const m = messages(locale);
const date = evaluationDateFor();
---

<Base locale={locale} title={`${m.changes.title} · ${PRODUCT.name}`} description={m.changes.intro} path={paths.changes(locale)} current="changes" evaluationDate={date}>
  <ChangesPage env={{locale, m, date}} />
</Base>
