---
/** One editorial story. Old slugs and story IDs redirect permanently. */
import Base from '../../../layouts/Base.astro';
import {StoryPage} from '../../../views/Story.tsx';
import {isLocale, PRODUCT} from '../../../config.ts';
import {messages} from '../../../i18n/index.ts';
import {catalog, evaluationDateFor} from '../../../server/site.ts';
import {storyModel} from '../../../server/story.ts';
import {paths} from '../../../model/urls.ts';

const {locale, slug} = Astro.params;
if (!isLocale(locale) || !slug) return Astro.rewrite('/404');

const resolved = catalog.resolveStory(slug);
if (resolved.kind === 'redirect') return Astro.redirect(paths.story(locale, resolved.slug), 301);
if (resolved.kind === 'missing') return Astro.rewrite('/404');

const story = resolved.value;
const m = messages(locale);
const date = evaluationDateFor();
const model = storyModel(story);
const origin = Astro.url.origin;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: story.data.title,
  description: story.data.dek,
  inLanguage: 'en',
  dateModified: story.data.reviewedAt,
  url: `${origin}${paths.story(locale, story.slug)}`,
  isPartOf: {'@type': 'WebSite', name: PRODUCT.name, url: `${origin}${paths.home(locale)}`},
  about: story.data.objectIds.map(id => ({'@type': 'Thing', name: catalog.nameOf(id), url: `${origin}${paths.object(locale, catalog.object(id)?.slug ?? id)}`})),
  citation: model.citations.ids.map(id => catalog.claims.get(id)?.sourceUrl).filter(Boolean),
};
---

<Base locale={locale} title={`${story.data.title} · ${PRODUCT.name}`} description={story.data.dek} path={paths.story(locale, story.slug)} current="stories" ogType="article" jsonLd={jsonLd} evaluationDate={date}>
  <StoryPage model={model} env={{locale, m, date}} />
</Base>
