---
/**
 * The directory: EDI's one-sentence account of how it complements L2BEAT,
 * then search, filters and populated results in the first viewport, with the
 * two editorial entrances inside the working layout. The built page shows the
 * editor's order; the island reads a search, filters or a comparison
 * selection from the address and computes the results in the browser.
 * Without scripts the page lists every record.
 */
import Base from '../../layouts/Base.astro';
import DirectoryApp from '../../islands/DirectoryApp.tsx';
import {ResultsBody} from '../../components/ResultsBody.tsx';
import {describeL2beat} from 'ethereum-decentralization-index';
import {GradeBadge} from '../../components/Grade.tsx';
import {ExternalIcon} from '../../components/Icons.tsx';
import {EDI_LOCALE, LOCALES, PRODUCT, type Locale} from '../../config.ts';
import {messages} from '../../i18n/index.ts';
import {fmt, formatCount, plural} from '../../i18n/format.ts';
import {SITE_URL} from '../../server/origin.ts';
import {catalog, EVALUATION_DATE} from '../../server/site.ts';
import {bodyContext, CHAIN_NAMES, directoryMessages, indexFor, preparedFor} from '../../server/directory.ts';
import {EMPTY_QUERY} from '../../model/query.ts';
import {runDirectory} from '../../model/directory.ts';
import {paths} from '../../model/urls.ts';
import {datedView} from '../../model/views.ts';

export function getStaticPaths() {
  return LOCALES.map(locale => ({params: {locale}}));
}

const locale = Astro.params.locale as Locale;
const m = messages(locale);
const date = EVALUATION_DATE;
const index = indexFor(locale);
const query = EMPTY_QUERY;
const result = runDirectory(preparedFor(locale), query, date, locale);
/** Every record on one page, for readers without scripts. */
const everything = runDirectory(preparedFor(locale), query, date, locale, catalog.objects.length);

const dm = directoryMessages(locale);
const ctx = bodyContext(locale, query, dm);

// The two editorial entrances, each a real example from the edition.
const d0 = catalog.collections.get('d0-in-use');
const global = catalog.collections.get('global-economy');
const entranceStory = (storyId?: string) => (storyId ? catalog.story(storyId) : undefined);
const d0Story = entranceStory(d0?.entrance.storyId);
const globalStory = entranceStory(global?.entrance.storyId);
const d0Count = catalog.objects.filter(object => {
  const state = catalog.rawOn(object.id, date).mechanism;
  return state.status === 'assessed' && state.effectiveLevel === 0;
}).length;
const d0Badge = datedView('weth9', catalog.rawOn('weth9', date), locale).mechanism;
/** EDI's own words on how it complements L2BEAT, the authority on scientific risk assessment. */
const l2beat = describeL2beat(EDI_LOCALE[locale]);

const showRoles = index.roleCoverage >= 0.5;
const description = fmt(m.meta.description, {count: formatCount(catalog.objects.length, locale)});
const title = fmt(m.meta.homeTitle, {name: PRODUCT.name});
const jsonLd = SITE_URL
  ? {
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: PRODUCT.name,
      alternateName: PRODUCT.shortName,
      url: `${SITE_URL}${paths.home(locale)}`,
      inLanguage: locale,
      potentialAction: {'@type': 'SearchAction', target: `${SITE_URL}${paths.home(locale)}?q={search_term_string}`, 'query-input': 'required name=search_term_string'},
    }
  : undefined;
---

<Base locale={locale} title={title} description={description} path={paths.home(locale)} current="directory" jsonLd={jsonLd} evaluationDate={date}>
  <div class="shell">
    <h1 class="home-title">{m.directory.heading}</h1>
    <div class="home-intro">
      <p>{l2beat.summary}</p>
      <p class="home-intro-links">
        <a href={`${paths.methodology(locale)}#l2beat`}>{l2beat.title}</a>
        <a class="external-link" href={l2beat.link.href} rel="noopener noreferrer">{l2beat.link.label}<ExternalIcon /><span class="sr-only"> ({m.common.external})</span></a>
      </p>
    </div>
    <DirectoryApp
      client:load
      locale={locale}
      m={dm}
      title={title}
      evaluatedFor={date}
      changeDates={[...catalog.changeDates]}
      summary={{total: result.total, page: result.page, pages: result.pages, sort: result.sort, facets: result.facets}}
      networks={index.networks.map(({id, name}) => ({id, name}))}
      roles={index.roles}
      showRoles={showRoles}
      chainNames={CHAIN_NAMES}
      indexUrl={paths.index(locale, catalog.edition.id)}
    >
      <div slot="entrances" class="entrances">
        <article class="entrance">
          <span class="entrance-art" aria-hidden="true"><GradeBadge grade={d0Badge} m={m} /></span>
          <p class="entrance-kicker"><a class="entrance-collection" href={paths.collection(locale, 'd0-in-use')}>{d0?.title ?? m.collections['d0-in-use']}</a></p>
          {
            d0Story ? (
              <>
                <h2 class="entrance-title"><a href={paths.story(locale, d0Story.slug)}>{d0Story.data.title}</a></h2>
                <p class="entrance-line">{d0?.entrance.line ?? d0Story.data.dek}</p>
              </>
            ) : (
              <h2 class="entrance-title"><a href={paths.collection(locale, 'd0-in-use')}>{plural(d0Count, locale, m.collections.d0Count)}</a></h2>
            )
          }
        </article>
        <article class="entrance">
          <span class="entrance-art entrance-spectrum" aria-hidden="true">
            {[0, 2, 4, 6, 9].map(level => <span class={`bar g${level}`}></span>)}
          </span>
          <p class="entrance-kicker"><a class="entrance-collection" href={paths.collection(locale, 'global-economy')}>{global?.title ?? m.collections['global-economy']}</a></p>
          {
            globalStory ? (
              <>
                <h2 class="entrance-title"><a href={paths.story(locale, globalStory.slug)}>{globalStory.data.title}</a></h2>
                <p class="entrance-line">{global?.entrance.line ?? globalStory.data.dek}</p>
              </>
            ) : (
              <h2 class="entrance-title"><a href={paths.collection(locale, 'global-economy')}>{m.collections.noStories}</a></h2>
            )
          }
        </article>
      </div>
      <div class="js-only"><ResultsBody result={result} ctx={ctx} /></div>
      <noscript>
        <p class="notice">{m.directory.noScript}</p>
        <ResultsBody result={everything} ctx={ctx} />
      </noscript>
    </DirectoryApp>
  </div>
</Base>
