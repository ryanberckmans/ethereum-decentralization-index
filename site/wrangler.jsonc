// The directory runs as one Cloudflare Worker: pages are rendered on request,
// because EDI grades are evaluated for the visitor's UTC date, and dist/client
// is served as static assets. `npm run build` writes the complete config to
// dist/server/wrangler.json, which `npx wrangler deploy` then uses.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "edi-directory",
  "compatibility_date": "2026-10-01",
  "observability": {"enabled": true},
}
